# Gemini API key (Required for running agents with Gemini)
# Get your key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model Name (Optional, options: gemini-3.5-flash, gemini-2.5-flash, gemini-2.0-flash, gemini-2.5-pro)
MODEL_NAME=gemini-3.5-flash

# Optional GitHub token: required for the public GraphQL contribution summary and
# useful for higher REST API rate limits. Use a fine-grained, least-privilege token.
GITHUB_TOKEN=your_github_token_here

# Additional / Custom API Keys (Optional)
# OPENAI_API_KEY=your_openai_api_key_here
# SERPER_API_KEY=your_serper_api_key_here
